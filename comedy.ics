BEGIN:VEVENT
SUMMARY:Manny’s: Bernice Ye: Wuhan Clan Ain't Nuthin' ta Duck Wit | Live
  Comedy SF
DTSTART;TZID=America/Los_Angeles:20261114T193000
DTEND;TZID=America/Los_Angeles:20261114T210000
DTSTAMP:20261111T171419Z
