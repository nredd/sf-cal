SUMMARY:De Ayer a Hoy / From Yesterday to Today
DTSTART;TZID=America/Los_Angeles:20261017T193000
DTEND;TZID=America/Los_Angeles:20261017T213000
DTSTAMP:20261006T001200Z
UID:dothebay-17862007@sf-cal
