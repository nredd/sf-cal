SUMMARY:Pivot w/ Kara Swisher & Scott Galloway
DTSTART;TZID=America/Los_Angeles:20261107T193000
DTEND;TZID=America/Los_Angeles:20261107T213000
DTSTAMP:20261108T061419Z
UID:dothebay-17857139@sf-cal
