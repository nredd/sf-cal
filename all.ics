BEGIN:VEVENT
SUMMARY:Nosferatu: A Symphony of Horror with LIVE SCORE by Dallas Acid & P
 az Lenchantin
DTSTART;TZID=America/Los_Angeles:20261023T200000
DTEND;TZID=America/Los_Angeles:20261023T220000
