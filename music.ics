BEGIN:VEVENT
SUMMARY:SF’s “Golden Hour” Filipino Night Market is Back for 2026 (S
 oMa)
DTSTART;TZID=America/Los_Angeles:20261024T160000
DTEND;TZID=America/Los_Angeles:20261024T220000
